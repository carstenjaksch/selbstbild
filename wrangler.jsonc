{
  // Selbstbild: statische Seite + kleine API für verschlüsselte Stände.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selbstbild",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Datenbank fest in der EU: wrangler d1 create selbstbild --jurisdiction=eu
  "d1_databases": [
    { "binding": "DB", "database_name": "selbstbild", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Täglich: Stände löschen, die 24 Monate nicht geändert wurden
  "triggers": { "crons": ["17 3 * * *"] },
  // Schutz vor Missbrauch der Speicher-API: 30 Schreibvorgänge pro Minute je Verbindung
  "ratelimits": [
    { "name": "SCHREIBLIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  // Keine Request-Protokolle (würden IP-Adressen enthalten)
  "observability": { "enabled": false }
}
